# ======================================================
# BOT TELEGRAM - CONFIGURATION TEMPLATE
# ======================================================

# Token Telegram Bot resmi dari @BotFather
BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"

# User ID Telegram Pemilik / Admin Utama (Angka ID asli Anda)
USER_ID_ADMIN="123456789"

# Channel untuk Monitoring Transaksi (Bisa @username_channel jika public, atau -100xxxxxxxxxx jika private)
USER_ID_CHANNEL="@your_channel_username"

# Koneksi Database PostgreSQL Supabase (Berbagi database dengan Web Store)
DB_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Payment Gateway QRIS NovaPay (https://novpay.id)
API_KEY_PG="nvp_YOUR_NOVAPAY_API_KEY"

# Pengaturan Toko & Tautan Media Sosial
NAMA_TOKO="Digital Store"
DESKRIPSI_TOKO="Dapatkan berbagai akun aplikasi digital premium hemat dan otomatis 24 jam."
USERNAME_TG_ADMIN="https://t.me/your_admin_username"
USERNAME_CHANNEL="https://t.me/your_channel_username"

# Jumlah Produk per Halaman di Katalog Bot
ITEM_PER_HALAMAN=6
